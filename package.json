{
  "name": "effect-libreoffice-workspace",
  "private": true,
  "type": "module",
  "version": "2.0.0-dev",
  "scripts": {
    "build": "pnpm -r build",
    "build:docker": "docker build -f apps/server/Dockerfile -t fiws/libre-convert .",
    "test": "vitest run",
    "bench": "vitest bench",
    "typecheck": "tsc --noEmit",
    "generate-docs": "typedoc",
    "check": "biome check",
    "check:fix": "biome check --write",
    "prepare": "effect-language-service patch"
  },
  "repository": {
    "url": "https://github.com/fiws/effect-libreoffice"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@changesets/cli": "^3.0.3",
    "@effect/language-service": "^0.87.5",
    "@effect/vitest": "4.1.2",
    "@types/node": "^26.6.6",
    "effect": "4.1.2",
    "pkg-pr-new": "^0.0.93",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
